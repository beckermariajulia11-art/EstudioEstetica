@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="text-muted small">Estúdio de Estética — Sistema de Gestão</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
