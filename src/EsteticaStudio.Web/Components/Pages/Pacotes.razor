@page "/pacotes"
@rendermode InteractiveServer
@using EsteticaStudio.Domain.Entities
@using EsteticaStudio.Domain.Enums
@inject EsteticaStudio.Application.Services.PacoteService PacoteService
@inject EsteticaStudio.Application.Services.ClienteService ClienteService
@inject EsteticaStudio.Application.Services.ProcedimentoService ProcedimentoService

<PageTitle>Pacotes</PageTitle>

<div class="page-header">
    <h2>📦 Pacotes de Sessões</h2>
    <button class="btn btn-primary" @onclick="AbrirFormNovo">+ Vender Pacote</button>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible">
        @mensagem <button type="button" class="btn-close" @onclick="() => mensagem = string.Empty"></button>
    </div>
}

@if (mostrarForm)
{
    <div class="card form-card mb-4">
        <div class="card-body">
            <h5 class="card-title">Vender Pacote</h5>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Cliente *</label>
                    <select class="form-select" @bind="idClienteSel">
                        <option value="">Selecione...</option>
                        @foreach (var c in clientes)
                        {
                            <option value="@c.Id">@c.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Procedimento *</label>
                    <select class="form-select" @bind="idProcedimentoSel">
                        <option value="">Selecione...</option>
                        @foreach (var p in procedimentos)
                        {
                            <option value="@p.Id">@p.Nome (@p.DuracaoMinutos min)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Qtd. de Sessões *</label>
                    <input type="number" class="form-control" @bind="quantidade" min="1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Valor Total (R$) *</label>
                    <input type="number" step="0.01" class="form-control" @bind="valor" min="0" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success" @onclick="Vender">Confirmar Venda</button>
                <button class="btn btn-outline-secondary" @onclick="() => mostrarForm = false">Cancelar</button>
            </div>
        </div>
    </div>
}

@* Filtro por cliente *@
<div class="row g-2 mb-3">
    <div class="col-auto">
        <select class="form-select" @bind="filtroClienteId" @bind:after="Filtrar">
            <option value="">Todos os clientes</option>
            @foreach (var c in clientes)
            {
                <option value="@c.Id">@c.Nome</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="LimparFiltro">Limpar</button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Cliente</th><th>Procedimento</th>
                <th>Contratadas</th><th>Utilizadas</th><th>Saldo</th>
                <th>Valor</th><th>Status</th><th style="width:90px">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pk in pacotesFiltrados)
            {
                <tr>
                    <td>@pk.Cliente.Nome</td>
                    <td>@pk.Procedimento.Nome</td>
                    <td class="text-center">@pk.QuantidadeContratada</td>
                    <td class="text-center">@pk.SessoesUtilizadas</td>
                    <td class="text-center fw-bold @(pk.SessoesDisponiveis > 0 ? "text-success" : "text-danger")">@pk.SessoesDisponiveis</td>
                    <td>R$ @pk.Valor.ToString("F2")</td>
                    <td><span class="badge @BadgeClass(pk.Status)">@pk.Status</span></td>
                    <td>
                        @if (pk.Status == StatusPacote.Ativo)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Cancelar(pk.Id)" title="Cancelar pacote">✖</button>
                        }
                        else { <span class="text-muted">—</span> }
                    </td>
                </tr>
            }
            @if (!pacotesFiltrados.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">Nenhum pacote encontrado.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    List<PacoteSessao> pacotes = new(), pacotesFiltrados = new();
    List<EsteticaStudio.Domain.Entities.Cliente> clientes = new();
    List<Procedimento> procedimentos = new();

    string idClienteSel = "", idProcedimentoSel = "", filtroClienteId = "";
    int quantidade = 1;
    decimal valor = 0;
    bool mostrarForm, erro;
    string mensagem = "";

    protected override void OnInitialized()
    {
        clientes = ClienteService.Listar();
        procedimentos = ProcedimentoService.Listar();
        Carregar();
    }

    void Carregar() { pacotes = PacoteService.Listar(); Filtrar(); }

    void Filtrar()
    {
        pacotesFiltrados = string.IsNullOrEmpty(filtroClienteId) || !Guid.TryParse(filtroClienteId, out var gid)
            ? pacotes
            : pacotes.Where(p => p.Cliente.Id == gid).ToList();
    }

    void LimparFiltro() { filtroClienteId = ""; Filtrar(); }

    void AbrirFormNovo() { mostrarForm = true; idClienteSel = idProcedimentoSel = ""; quantidade = 1; valor = 0; }

    void Vender()
    {
        try
        {
            if (string.IsNullOrEmpty(idClienteSel) || string.IsNullOrEmpty(idProcedimentoSel))
                throw new Exception("Selecione cliente e procedimento.");
            PacoteService.VenderPacote(Guid.Parse(idClienteSel), Guid.Parse(idProcedimentoSel), quantidade, valor);
            mostrarForm = false; Carregar(); Msg("Pacote vendido com sucesso!", false);
        }
        catch (Exception ex) { Msg(ex.Message, true); }
    }

    void Cancelar(Guid id)
    {
        try { PacoteService.Cancelar(id); Carregar(); Msg("Pacote cancelado!", false); }
        catch (Exception ex) { Msg(ex.Message, true); }
    }

    string BadgeClass(StatusPacote s) => s switch
    {
        StatusPacote.Ativo => "bg-success",
        StatusPacote.Encerrado => "bg-secondary",
        StatusPacote.Cancelado => "bg-danger",
        _ => "bg-light text-dark"
    };

    void Msg(string m, bool e) { mensagem = m; erro = e; }
}
