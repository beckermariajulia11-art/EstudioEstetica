@page "/procedimentos"
@rendermode InteractiveServer
@using EsteticaStudio.Domain.Entities
@inject EsteticaStudio.Application.Services.ProcedimentoService ProcedimentoService

<PageTitle>Procedimentos</PageTitle>

<div class="page-header">
    <h2>✨ Procedimentos</h2>
    <button class="btn btn-primary" @onclick="AbrirFormNovo">+ Novo Procedimento</button>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible">
        @mensagem <button type="button" class="btn-close" @onclick="() => mensagem = string.Empty"></button>
    </div>
}

@if (mostrarForm)
{
    <div class="card form-card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(editando ? "Editar Procedimento" : "Novo Procedimento")</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nome *</label>
                    <input class="form-control" @bind="nome" placeholder="Ex: Limpeza de pele, Drenagem..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Duração (minutos) *</label>
                    <input type="number" class="form-control" @bind="duracaoMinutos" min="1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Descrição</label>
                    <input class="form-control" @bind="descricao" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success" @onclick="Salvar">Salvar</button>
                <button class="btn btn-outline-secondary" @onclick="() => mostrarForm = false">Cancelar</button>
            </div>
        </div>
    </div>
}

<div class="mb-3">
    <input class="form-control" style="max-width:360px" @bind="busca" @bind:event="oninput" placeholder="🔍 Buscar..." />
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr><th>Nome</th><th>Duração</th><th>Descrição</th><th style="width:120px">Ações</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Filtrados)
            {
                <tr>
                    <td>@p.Nome</td><td>@p.DuracaoMinutos min</td><td>@p.Descricao</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => AbrirEditar(p)">✏</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Remover(p.Id)">🗑</button>
                    </td>
                </tr>
            }
            @if (!Filtrados.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">Nenhum procedimento encontrado.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    List<Procedimento> lista = new();
    string busca = "", nome = "", descricao = "";
    int duracaoMinutos = 60;
    bool mostrarForm, editando, erro;
    string mensagem = "";
    Guid idEditando;

    IEnumerable<Procedimento> Filtrados => string.IsNullOrWhiteSpace(busca) ? lista
        : lista.Where(p => p.Nome.Contains(busca, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => lista = ProcedimentoService.Listar();
    void AbrirFormNovo() { editando = false; mostrarForm = true; nome = descricao = ""; duracaoMinutos = 60; }
    void AbrirEditar(Procedimento p) { editando = true; mostrarForm = true; idEditando = p.Id; nome = p.Nome; duracaoMinutos = p.DuracaoMinutos; descricao = p.Descricao; }

    void Salvar()
    {
        try
        {
            if (editando) ProcedimentoService.Atualizar(idEditando, nome, duracaoMinutos, descricao);
            else ProcedimentoService.Cadastrar(nome, duracaoMinutos, descricao);
            mostrarForm = false; lista = ProcedimentoService.Listar();
            Msg(editando ? "Procedimento atualizado!" : "Procedimento cadastrado!", false);
        }
        catch (Exception ex) { Msg(ex.Message, true); }
    }

    void Remover(Guid id)
    {
        try { ProcedimentoService.Remover(id); lista = ProcedimentoService.Listar(); Msg("Procedimento removido!", false); }
        catch (Exception ex) { Msg(ex.Message, true); }
    }

    void Msg(string m, bool e) { mensagem = m; erro = e; }
}
