@page "/clientes"
@rendermode InteractiveServer
@using EsteticaStudio.Domain.Entities
@inject EsteticaStudio.Application.Services.ClienteService ClienteService

<PageTitle>Clientes</PageTitle>

<div class="page-header">
    <h2>👤 Clientes</h2>
    <button class="btn btn-primary" @onclick="AbrirFormNovo">+ Novo Cliente</button>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert @(erro ? "alert-danger" : "alert-success") alert-dismissible">
        @mensagem <button type="button" class="btn-close" @onclick="() => mensagem = string.Empty"></button>
    </div>
}

@if (mostrarForm)
{
    <div class="card form-card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(editando ? "Editar Cliente" : "Novo Cliente")</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nome *</label>
                    <input class="form-control" @bind="nome" placeholder="Nome completo" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Telefone</label>
                    <input class="form-control" @bind="telefone" placeholder="(00) 00000-0000" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">E-mail</label>
                    <input class="form-control" @bind="email" placeholder="email@exemplo.com" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success" @onclick="Salvar">Salvar</button>
                <button class="btn btn-outline-secondary" @onclick="() => mostrarForm = false">Cancelar</button>
            </div>
        </div>
    </div>
}

<div class="mb-3">
    <input class="form-control" style="max-width:360px" @bind="busca" @bind:event="oninput" placeholder="🔍 Buscar por nome ou e-mail..." />
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr><th>Nome</th><th>Telefone</th><th>E-mail</th><th style="width:120px">Ações</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Filtrados)
            {
                <tr>
                    <td>@c.Nome</td><td>@c.Telefone</td><td>@c.Email</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => AbrirEditar(c)">✏</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Remover(c.Id)">🗑</button>
                    </td>
                </tr>
            }
            @if (!Filtrados.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">Nenhum cliente encontrado.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    List<Cliente> lista = new();
    string busca = "", nome = "", telefone = "", email = "";
    bool mostrarForm, editando, erro;
    string mensagem = "";
    Guid idEditando;

    IEnumerable<Cliente> Filtrados => string.IsNullOrWhiteSpace(busca) ? lista
        : lista.Where(c => c.Nome.Contains(busca, StringComparison.OrdinalIgnoreCase)
                        || c.Email.Contains(busca, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => lista = ClienteService.Listar();

    void AbrirFormNovo() { editando = false; mostrarForm = true; nome = telefone = email = ""; }
    void AbrirEditar(Cliente c) { editando = true; mostrarForm = true; idEditando = c.Id; nome = c.Nome; telefone = c.Telefone; email = c.Email; }

    void Salvar()
    {
        try
        {
            if (editando) ClienteService.Atualizar(idEditando, nome, telefone, email);
            else ClienteService.Cadastrar(nome, telefone, email);
            mostrarForm = false; lista = ClienteService.Listar();
            Msg(editando ? "Cliente atualizado!" : "Cliente cadastrado!", false);
        }
        catch (Exception ex) { Msg(ex.Message, true); }
    }

    void Remover(Guid id)
    {
        try { ClienteService.Remover(id); lista = ClienteService.Listar(); Msg("Cliente removido!", false); }
        catch (Exception ex) { Msg(ex.Message, true); }
    }

    void Msg(string m, bool e) { mensagem = m; erro = e; }
}
